#### gitignore is a symbolic link to .gitignore
gitignore

#### containers
*.sif

#### file name tag for any file that want to let git ignore
*.GITIGNORE.*
*.NOGIT.*

#### secondary scripts generated by the scripts in bin
/bin/s*/*

#### vscode
.vscode

#### scripts for test when developing
*/bin/test

#### condor jobs
*.condor
*.condor.err
*.condor.log
*.condor.out

#### input dir
input

#### output dir
output

#### local dir
output_local
.Rhistory
.RData
.RDataTmp

#### rsync scripts and their logs
rsync\.*.sh
rsync\.*.log

#### Temp dir for gatk
gatk_tmp

