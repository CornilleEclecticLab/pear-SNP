# gitignore is a symbolic link to .gitignore
gitignore

# secondary scripts generated by the scripts in bin
*/bin/s*/*

# scripts for test when developing
*/bin/test

# condor jobs
*.condor
*.condor.err
*.condor.log
*.condor.out

# input dir
input

# output dir
output

# local dir
output_local
.Rhistory
.RData
.RDataTmp

# rsync scripts
rsync\.*.sh
rsync\.*.log
