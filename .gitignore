#### gitignore is a symbolic link to .gitignore
gitignore

#### file name tag for any file that want to let git ignore
*.GITIGNORE.*
*.NOGIT.*

#### secondary scripts generated by the scripts in bin
*/bin/s*/*

#### vscode
.vscode

#### scripts for test when developing
*/bin/test

#### condor jobs
*.condor
*.condor.err
*.condor.log
*.condor.out

#### slurm jobs
*[0-9][0-9][0-9].err
*[0-9][0-9][0-9].out

#### input and output dir
input
output


#### local dir
output_local
.Rhistory
.RData
.RDataTmp
.vscode

#### rsync scripts and their logs
rsync\.*.sh
rsync\.*.log

#### Temp dir for gatk
gatk_tmp

