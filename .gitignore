#### gitignore is a symbolic link to .gitignore
gitignore

#### containers
*.sif

#### file name tag for any file that want to let git ignore
*.GITIGNORE.*
*.NOGIT.*

#### secondary scripts generated by the scripts in bin
*/bin/s*/*

#### vscode
.vscode

#### scripts for test when developing
*/bin/test

#### condor jobs
*.condor
*.condor.err
*.condor.log
*.condor.out

#### slurm jobs
*[0-9][0-9][0-9].err
*[0-9][0-9][0-9].out

#### Ignore input, output and database directories to prevent large or transient files from bloating the repository
input
output
database

#### local dir
output_local
.Rhistory
.RData
.RDataTmp
.vscode
.ipynb_checkpoints/

#### rsync scripts and their logs
rsync\.*.sh
rsync\.*.log

#### Temp dir for gatk
gatk_tmp

